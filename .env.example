# GitHub Personal Access Token (classic or fine-grained with public read permission)
# Required for GitHub GraphQL API queries (https://github.com/settings/tokens)
GITHUB_TOKEN=your_github_token_here

# StackApps API Key (Optional, increases quota from 300 to 10,000 req/day)
# Obtain at https://stackapps.com/apps/oauth/register
STACKAPPS_KEY=your_stackapps_key_here

# Twitch Application Credentials (Required for Twitch Helix API)
# Obtain at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# --- Abuse control (optional) ---

# Requests per minute, per IP and per provider. Default: 60.
# Warning: the counter lives in the isolate memory (api/utils/ratelimit.ts), so
# the effective ceiling is this value multiplied by the number of active isolates.
# To contain distributed abuse, also add a rule in the Vercel Firewall.
RATE_LIMIT_MAX_PER_MINUTE=60

# How many of your own proxies sit in front of the application, so we know which
# segment of X-Forwarded-For is trustworthy. Default: 1 (the Vercel edge).
# Only increase it if you placed additional proxies in front yourself.
TRUSTED_PROXY_HOPS=1

# Optional allowlist of identifiers, comma-separated, for private
# installations. Empty or absent = any identifier is accepted.
ALLOWED_USERS=